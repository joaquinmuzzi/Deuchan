{
  "manifest_version": 3,
  "name": "Deuchan",
  "version": "0.1.0",
  "description": "Counts the time you spend watching German on YouTube, automatically. Daily goal, charts and optional encrypted sync.",
  "homepage_url": "https://github.com/joaquinmuzzi/deuchan",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://sync-production-78f2.up.railway.app/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Deuchan",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png",
      "128": "icons/idle-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/tracker.js", "src/watcher.js", "src/language.js", "src/overrides.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
