{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.2.3",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/joaquinmuzzi/inputly",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms", "idle", "activeTab"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Inputly",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png",
      "128": "icons/idle-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/tracker.js",
        "src/watcher.js",
        "src/language.js",
        "src/overrides.js",
        "src/immersion.js",
        "src/target.js",
        "src/delivery.js"
      ],
      "matches": ["https://www.youtube.com/*"]
    },
    {
      "resources": ["src/tracker.js", "src/watcher.js", "src/delivery.js"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": [
        "src/sites.js",
        "src/streaming.js",
        "src/items.js",
        "src/overrides.js",
        "src/target.js",
        "src/immersion.js",
        "src/watcher.js",
        "src/tracker.js",
        "src/delivery.js"
      ],
      "matches": [
        "https://www.netflix.com/*",
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.jp/*",
        "https://www.disneyplus.com/*"
      ]
    }
  ]
}
